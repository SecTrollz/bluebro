<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:accessibilityHeading="true"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/setupStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_not_associated"
            android:textAlignment="center"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/associateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/associate_device"
            android:layout_marginBottom="28dp" />

        <TextView
            android:id="@+id/liveStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_status_label"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/liveStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/live_status_unknown"
            android:textAlignment="center"
            android:textSize="18sp"
            android:accessibilityLiveRegion="polite"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
